# Server
PORT=3000

# MongoDB — use a cloud URI (e.g. MongoDB Atlas) in production
MONGO_URI=mongodb://localhost:27017/turf_booking

# Auth
JWT_SECRET=change_this_to_a_long_random_secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3001

# Redis — optional, leave blank to skip Redis connection
REDIS_URL=redis://localhost:6379

# Razorpay — optional, only needed when real payments are enabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
